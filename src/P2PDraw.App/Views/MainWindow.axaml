<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:P2PDraw.App.Views"
        xmlns:vm="using:P2PDraw.App.ViewModels"
        x:Class="P2PDraw.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding SessionTitle, StringFormat='P2PDraw · {0}'}"
        Width="1180" Height="760" MinWidth="320" MinHeight="360" Background="#EEF1F5">
    <views:MainView x:Name="EditorView" />
</Window>
