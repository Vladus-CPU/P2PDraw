<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:P2PDraw.App.Controls"
             xmlns:vm="using:P2PDraw.App.ViewModels"
             xmlns:discovery="using:P2PDraw.Networking.Discovery"
             xmlns:views="using:P2PDraw.App.Views"
             x:Class="P2PDraw.App.Views.MainView" x:DataType="vm:MainWindowViewModel" Background="#EEF1F5">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#5B687A" />
        </Style>
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="44" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Button.selected">
            <Setter Property="Background" Value="#D8E7FC" />
            <Setter Property="Foreground" Value="#205C9F" />
        </Style>
    </UserControl.Styles>
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" Margin="16">
        <Grid x:Name="HeaderGrid" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" Margin="0,0,0,10">
            <StackPanel Spacing="1">
                <TextBlock x:Name="AppTitle" Text="P2PDraw" FontSize="23" FontWeight="SemiBold" Foreground="#253449" />
                <TextBlock Text="{Binding SessionTitle}" Classes="label" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ConnectedPeers, StringFormat='Підключень: {0}'}" Classes="label" />
            </StackPanel>
            <Button x:Name="SessionButton" Grid.Column="2" Content="Сесія" Click="OnSessionClicked" ToolTip.Tip="Створення сесії та підключення" />
        </Grid>
        <Border x:Name="BrushPanel" Grid.Row="1" Background="White" CornerRadius="9" BorderBrush="#D7DFEA" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="SelectTool" Classes="tool" Tag="Select" Click="OnToolClicked" ToolTip.Tip="Вибір і переміщення" Margin="0,0,4,2">
                    <Path Data="M3,2 L3,19 8,14 12,22 15,20 11,13 18,12 Z" Fill="{Binding $parent[Button].Foreground}" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <Button x:Name="BrushTool" Classes="tool selected" Tag="Brush" Click="OnToolClicked" ToolTip.Tip="Пензель" Margin="0,0,4,2">
                    <Path Data="M3,16 L4,12 14,2 18,6 8,16 Z M4,12 L8,16" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <Button x:Name="LineTool" Classes="tool" Tag="Line" Click="OnToolClicked" ToolTip.Tip="Пряма лінія" Margin="0,0,4,2">
                    <Path Data="M2,20 L20,2" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <Button x:Name="RectangleTool" Classes="tool" Tag="Rectangle" Click="OnToolClicked" ToolTip.Tip="Прямокутник" Margin="0,0,4,2">
                    <Path Data="M2,3 L20,3 20,19 2,19 Z" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <Button x:Name="EllipseTool" Classes="tool" Tag="Ellipse" Click="OnToolClicked" ToolTip.Tip="Еліпс" Margin="0,0,4,2">
                    <Ellipse Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.8" Width="22" Height="18" />
                </Button>
                <Button x:Name="DeleteButton" Classes="tool" Click="OnDeleteClicked" IsEnabled="False" ToolTip.Tip="Видалити об'єкт" Margin="0,0,8,2">
                    <Path Data="M3,5 L19,5 M8,5 L8,2 14,2 14,5 M5,5 L6,21 16,21 17,5 M9,9 L9,17 M13,9 L13,17" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" Width="22" Height="22" Stretch="Uniform" />
                </Button>
                <ComboBox x:Name="BrushColors" Width="104" MinHeight="44" Margin="0,0,8,2" SelectedIndex="0" SelectionChanged="OnColorChanged" ToolTip.Tip="Колір контуру">
                    <ComboBoxItem Content="Чорний" Tag="#FF253449" />
                    <ComboBoxItem Content="Синій" Tag="#FF2563EB" />
                    <ComboBoxItem Content="Червоний" Tag="#FFDC2626" />
                    <ComboBoxItem Content="Зелений" Tag="#FF16835D" />
                    <ComboBoxItem Content="Фіолетовий" Tag="#FF7C3AED" />
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,8,2" VerticalAlignment="Center">
                    <Slider x:Name="BrushSize" Width="85" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding BrushWidth, Mode=TwoWay}" ToolTip.Tip="Товщина контуру" />
                    <TextBlock Text="{Binding BrushWidth, StringFormat='{}{0:0} px'}" Width="36" VerticalAlignment="Center" />
                </StackPanel>
                <CheckBox Content="Заливка" IsChecked="{Binding FillShapes, Mode=TwoWay}" MinHeight="44" Margin="0,0,8,2" />
                <Button x:Name="ClearButton" Content="Очистити полотно" Click="OnClearClicked" Foreground="#A52D36" ToolTip.Tip="Видалити відомі об'єкти на всіх шарах" />
            </WrapPanel>
        </Border>
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnDefinitions="*,Auto">
            <Border BorderBrush="#CCD5E1" BorderThickness="1" Background="White" CornerRadius="4" ClipToBounds="True">
                <controls:DrawingCanvas x:Name="DrawingSurface" Strokes="{Binding Strokes}" Shapes="{Binding Shapes}"
                                        VisibleLayerIds="{Binding LayerEditor.VisibleLayerIds}" SelectableLayerIds="{Binding LayerEditor.SelectableLayerIds}"
                                        CanDraw="{Binding LayerEditor.CanDraw}"
                                        StrokeColor="{Binding BrushColor}" StrokeWidth="{Binding BrushWidth}" FillShapes="{Binding FillShapes}" />
            </Border>
            <views:LayersPanel x:Name="LayerSide" Grid.Column="1" Width="240" Margin="8,0,0,0" DataContext="{Binding LayerEditor}" />
            <Border x:Name="NetworkPanel" Grid.ColumnSpan="2" IsVisible="False" MaxWidth="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="White" BorderBrush="#B8C7DA" BorderThickness="1" CornerRadius="10" Padding="14">
                <Expander x:Name="NetworkExpander" Header="Сесії та підключення" IsExpanded="False" HorizontalContentAlignment="Stretch">
                    <ScrollViewer x:Name="NetworkScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <Button x:Name="CreateSessionButton" Content="Створити сесію" Click="OnCreateSessionClicked" IsEnabled="{Binding CanCreateSession}" HorizontalAlignment="Stretch" />
                            <Button x:Name="SearchSessionsButton" Content="Знайти сесії" Click="OnSearchSessionsClicked" IsEnabled="{Binding CanSearchSessions}" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding DiscoveryStatus}" Classes="label" TextWrapping="Wrap" />
                            <ComboBox x:Name="SessionList" ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" PlaceholderText="Сесії в локальній мережі">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="discovery:DiscoveredPeer"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="JoinSessionButton" Content="Приєднатися" Click="OnJoinSessionClicked" IsEnabled="{Binding CanJoinSession}" HorizontalAlignment="Stretch" />
                            <Expander Header="Підключитися вручну" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="SessionId із запрошення" Classes="label" />
                                    <TextBox x:Name="SessionIdBox" Text="{Binding SessionId, Mode=TwoWay}" IsReadOnly="{Binding !CanEditSession}" FontSize="11" />
                                    <TextBlock Text="IP-адреса пристрою" Classes="label" />
                                    <TextBox x:Name="RemoteAddressBox" Text="{Binding RemoteAddress, Mode=TwoWay}" />
                                    <TextBlock Text="TCP-порт пристрою" Classes="label" />
                                    <TextBox x:Name="RemotePortBox" Text="{Binding RemotePort, Mode=TwoWay}" />
                                    <Button Content="Приєднатися за IP" Click="OnJoinManualClicked" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Локальний TCP-порт (0 — автоматично)" Classes="label" />
                                    <TextBox x:Name="LocalPortBox" Text="{Binding LocalPort, Mode=TwoWay}" IsReadOnly="{Binding !CanStartListening}" />
                                    <Button x:Name="ListenButton" Content="Слухати" Click="OnListenClicked" IsEnabled="{Binding CanStartListening}" />
                                    <Button x:Name="ConnectButton" Content="Підключити" Click="OnConnectClicked" IsEnabled="{Binding CanConnect}" />
                                    <TextBlock Text="Вузли поточної сесії" Classes="label" />
                                    <ComboBox x:Name="DiscoveredPeerList" ItemsSource="{Binding DiscoveredPeers}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="discovery:DiscoveredPeer"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="ConnectDiscoveredButton" Content="Підключити вибраний" Click="OnConnectDiscoveredClicked" IsEnabled="{Binding CanConnectDiscovered}" />
                                    <TextBlock Text="{Binding OperationCount, StringFormat='Операцій у журналі: {0}'}" Classes="label" />
                                </StackPanel>
                            </Expander>
                            <Button x:Name="DisconnectButton" Content="Відключити" Click="OnDisconnectClicked" IsEnabled="{Binding CanDisconnect}" />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Border>
        </Grid>
        <Grid x:Name="FooterGrid" Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" Margin="0,8,0,0">
            <TextBlock Text="{Binding Status}" Classes="label" TextTrimming="CharacterEllipsis" MaxHeight="32" VerticalAlignment="Center" />
            <Button x:Name="LayersButton" Grid.Column="1" Content="Шари" Click="OnLayersClicked" Padding="8,2" />
            <TextBlock Grid.Column="2" Text="{Binding ObjectCount, StringFormat='Об’єктів: {0}'}" Classes="label" VerticalAlignment="Center" />
            <Button x:Name="ResetZoomButton" Grid.Column="3" Content="100%" Click="OnResetViewClicked" ToolTip.Tip="Повернути масштаб 100% і центр полотна" MinHeight="32" Padding="8,2" />
        </Grid>
        <Border x:Name="ConfirmationOverlay" Grid.RowSpan="4" Background="#66000000" IsVisible="False">
            <Border Background="White" CornerRadius="10" Padding="20" Margin="12" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="CancelActionButton" Content="Скасувати" Click="OnCancelActionClicked" />
                        <Button x:Name="ConfirmActionButton" Content="Підтвердити" Click="OnConfirmActionClicked" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
