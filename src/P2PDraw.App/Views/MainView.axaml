<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:P2PDraw.App.Controls"
             xmlns:vm="using:P2PDraw.App.ViewModels"
             xmlns:discovery="using:P2PDraw.Networking.Discovery"
             xmlns:views="using:P2PDraw.App.Views"
             x:Class="P2PDraw.App.Views.MainView" x:DataType="vm:MainWindowViewModel" x:Name="RootView"
             Background="#EEF1F5" TopLevel.AutoSafeAreaPadding="True" UseLayoutRounding="True">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="{Binding #RootView.Layout.RowSpacing}" Margin="{Binding #RootView.Layout.RootMargin}">
        <Grid x:Name="HeaderGrid" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
            <StackPanel x:Name="BrandPanel" Spacing="1" VerticalAlignment="Center" IsVisible="{Binding #RootView.Layout.ShowBrand}">
                <TextBlock x:Name="AppTitle" Text="P2PDraw" FontSize="20" FontWeight="SemiBold" Foreground="#253449" />
                <TextBlock x:Name="SessionTitle" Text="{Binding SessionTitle}" Classes="label" TextTrimming="CharacterEllipsis" MaxWidth="220" />
            </StackPanel>
            <Button x:Name="FilesButton" Grid.Column="1" Content="Файл" Classes="secondary" Classes.selected="{Binding #RootView.Layout.ShowFiles}" Click="OnFilesClicked" />
            <StackPanel x:Name="ConnectionSummary" Grid.Column="2" Spacing="1" VerticalAlignment="Center" HorizontalAlignment="Right" MaxWidth="220">
                <TextBlock x:Name="ConnectionStatusText" Text="{Binding ConnectionStatus}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" IsVisible="{Binding #RootView.Layout.ShowDetails}" />
                <TextBlock Text="{Binding ConnectedPeers, StringFormat='{}{0} уч.'}" Classes="label" />
            </StackPanel>
            <Border x:Name="ConnectionIndicator" Grid.Column="3" Width="10" Height="10" CornerRadius="5" Background="#94A3B8" VerticalAlignment="Center"
                    ToolTip.Tip="{Binding ConnectionStatus}" AutomationProperties.Name="{Binding ConnectionStatus}" />
            <Button x:Name="LayersButton" Grid.Column="4" Content="Шари" Classes="secondary" Classes.selected="{Binding #RootView.Layout.ShowLayers}" Click="OnLayersClicked" />
            <Button x:Name="SessionButton" Grid.Column="5" Content="Сесія" Classes="secondary" Classes.selected="{Binding #RootView.Layout.ShowSession}" Click="OnSessionClicked" ToolTip.Tip="Створення сесії та підключення" />
        </Grid>
        <Border x:Name="BrushPanel" Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#D7DFEA" BorderThickness="1"
                Padding="{Binding #RootView.Layout.ToolbarPadding}" IsVisible="{Binding #RootView.Layout.ShowToolbarAndFooter}">
            <Grid x:Name="ToolbarGrid" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                <ScrollViewer x:Name="DrawingToolsScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button x:Name="SelectTool" Classes="tool" Tag="Select" Click="OnToolClicked" ToolTip.Tip="Вибір і переміщення" AutomationProperties.Name="Вибір і переміщення">
                            <Path Classes="icon" Data="M5,2 L5,18 9,14 12,22 15,21 12,13 19,13 Z" Fill="{Binding $parent[Button].Foreground}" />
                        </Button>
                        <Button x:Name="BrushTool" Classes="tool selected" Tag="Brush" Click="OnToolClicked" ToolTip.Tip="Пензель" AutomationProperties.Name="Пензель">
                            <Path Classes="icon" Data="M4,18 L5,14 15,4 20,9 10,19 6,20 Z M5,14 L10,19 M13,6 L18,11" />
                        </Button>
                        <Button x:Name="LineTool" Classes="tool" Tag="Line" Click="OnToolClicked" ToolTip.Tip="Пряма лінія" AutomationProperties.Name="Пряма лінія">
                            <Path Classes="icon" Data="M4,20 L20,4" />
                        </Button>
                        <Button x:Name="RectangleTool" Classes="tool" Tag="Rectangle" Click="OnToolClicked" ToolTip.Tip="Прямокутник" AutomationProperties.Name="Прямокутник">
                            <Path Classes="icon" Data="M3,4 L21,4 21,20 3,20 Z" />
                        </Button>
                        <Button x:Name="EllipseTool" Classes="tool" Tag="Ellipse" Click="OnToolClicked" ToolTip.Tip="Еліпс" AutomationProperties.Name="Еліпс">
                            <Path Classes="icon" Data="M3,12 A9,7 0 1 0 21,12 A9,7 0 1 0 3,12" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="EditToolsGroup" Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Border x:Name="EditSeparator" Width="1" Background="#D7DFEA" Margin="4,6" IsVisible="{Binding !#RootView.Layout.IsNarrow}" />
                    <Button x:Name="DeleteButton" Classes="tool" Click="OnDeleteClicked" IsEnabled="False" ToolTip.Tip="Видалити об'єкт" AutomationProperties.Name="Видалити об'єкт">
                        <Path Classes="icon" Data="M4,6 L20,6 M8,6 L8,3 16,3 16,6 M6,6 L7,21 17,21 18,6 M10,10 L10,17 M14,10 L14,17" />
                    </Button>
                    <Button x:Name="DuplicateButton" Classes="tool" Click="OnDuplicateClicked" IsEnabled="False" ToolTip.Tip="Дублювати об'єкт" AutomationProperties.Name="Дублювати об'єкт">
                        <Path Classes="icon" Data="M8,8 L20,8 20,20 8,20 Z M4,16 L4,4 16,4" />
                    </Button>
                    <Button x:Name="UndoButton" Classes="tool" Click="OnUndoClicked" IsEnabled="{Binding CanUndo}" ToolTip.Tip="Скасувати локальну дію" AutomationProperties.Name="Скасувати локальну дію">
                        <Path Classes="icon" Data="M10,5 L4,11 10,17 M4,11 L13,11 C17,11 20,14 20,19" />
                    </Button>
                    <Button x:Name="RedoButton" Classes="tool" Click="OnRedoClicked" IsEnabled="{Binding CanRedo}" ToolTip.Tip="Повторити локальну дію" AutomationProperties.Name="Повторити локальну дію">
                        <Path Classes="icon" Data="M14,5 L20,11 14,17 M20,11 L11,11 C7,11 4,14 4,19" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="PropertiesGroup" Grid.Column="2" Orientation="{Binding #RootView.Layout.PropertiesOrientation}" Spacing="8">
                    <Border x:Name="PropertiesSeparator" Width="1" Background="#D7DFEA" Margin="4,6" IsVisible="{Binding #RootView.Layout.InlineProperties}" />
                    <ComboBox x:Name="BrushColors" Width="136" SelectedIndex="0" SelectionChanged="OnColorChanged" ToolTip.Tip="Колір контуру" AutomationProperties.Name="Колір контуру">
                        <ComboBoxItem Tag="#FF253449">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#253449" />
                                <TextBlock Text="Чорний" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="#FF2563EB">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#2563EB" />
                                <TextBlock Text="Синій" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="#FFDC2626">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#DC2626" />
                                <TextBlock Text="Червоний" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="#FF16835D">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#16835D" />
                                <TextBlock Text="Зелений" />
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Tag="#FF7C3AED">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="14" Height="14" CornerRadius="3" Background="#7C3AED" />
                                <TextBlock Text="Фіолетовий" />
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>
                    <StackPanel x:Name="WidthSettings" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Slider x:Name="BrushSize" Width="85" Minimum="1" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding BrushWidth, Mode=TwoWay}" ToolTip.Tip="Товщина контуру" AutomationProperties.Name="Товщина контуру" />
                        <TextBlock Text="{Binding BrushWidth, StringFormat='{}{0:0} px'}" MinWidth="36" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox x:Name="FillSetting" Content="Заливка" IsChecked="{Binding FillShapes, Mode=TwoWay}" />
                </StackPanel>
                <Button x:Name="PropertiesButton" Grid.Column="3" Classes="tool" Click="OnPropertiesClicked" IsVisible="{Binding !#RootView.Layout.InlineProperties}" ToolTip.Tip="Колір і властивості" AutomationProperties.Name="Колір і властивості">
                    <Path Classes="icon" Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M8,3 L8,9 M16,9 L16,15 M10,15 L10,21" />
                </Button>
                <Button x:Name="MoreToolsButton" Grid.Column="4" Classes="tool" Click="OnMoreToolsClicked" IsVisible="{Binding #RootView.Layout.IsNarrow}" ToolTip.Tip="Редагування об'єктів" AutomationProperties.Name="Редагування об'єктів">
                    <Path Classes="icon" Data="M4,11 L4,13 M12,11 L12,13 M20,11 L20,13" />
                </Button>
            </Grid>
        </Border>
        <Grid x:Name="BodyGrid" Grid.Row="2" ColumnDefinitions="*,Auto">
            <Border x:Name="CanvasBorder" BorderBrush="#CCD5E1" BorderThickness="1" Background="White" CornerRadius="6" ClipToBounds="True">
                <controls:DrawingCanvas x:Name="DrawingSurface" Strokes="{Binding Strokes}" Shapes="{Binding Shapes}"
                                        VisibleLayerIds="{Binding LayerEditor.VisibleLayerIds}" SelectableLayerIds="{Binding LayerEditor.SelectableLayerIds}"
                                        CanDraw="{Binding LayerEditor.CanDraw}" StrokeColor="{Binding BrushColor}"
                                        StrokeWidth="{Binding BrushWidth}" FillShapes="{Binding FillShapes}" />
            </Border>
            <Button x:Name="PanelBackdrop" Classes="backdrop" Grid.ColumnSpan="2" IsVisible="{Binding #RootView.Layout.ShowBackdrop}" Click="OnClosePanelClicked" Background="#330F172A"
                    BorderThickness="0" Padding="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AutomationProperties.Name="Закрити панель" />
            <Border x:Name="SidePanel" Grid.Column="{Binding #RootView.Layout.PanelColumn}" Grid.ColumnSpan="{Binding #RootView.Layout.PanelColumnSpan}"
                    Width="{Binding #RootView.Layout.PanelWidth}" Margin="{Binding #RootView.Layout.PanelMargin}" IsVisible="{Binding #RootView.Layout.ShowPanel}"
                    HorizontalAlignment="Right" Padding="10" Background="White"
                    BorderBrush="#CCD5E1" BorderThickness="1" CornerRadius="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid x:Name="PanelHeader" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding #RootView.Layout.ShowPanelHeader}">
                        <TextBlock x:Name="PanelTitle" Text="{Binding #RootView.Layout.ActivePanel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="ClosePanelButton" Grid.Column="1" Classes="icon secondary" Click="OnClosePanelClicked" ToolTip.Tip="Закрити панель" AutomationProperties.Name="Закрити панель">
                            <Path Classes="icon" Data="M5,5 L19,19 M19,5 L5,19" />
                        </Button>
                    </Grid>
                    <views:LayersPanel x:Name="LayerSide" Grid.Row="1" DataContext="{Binding LayerEditor}" IsVisible="{Binding #RootView.Layout.ShowLayers}" />
                    <Border x:Name="NetworkPanel" Grid.Row="1" IsVisible="{Binding #RootView.Layout.ShowSession}">
                        <ScrollViewer x:Name="NetworkScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SessionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ConnectedPeers, StringFormat='Підключених учасників: {0}'}" Classes="label" TextWrapping="Wrap" />
                                <Button x:Name="CreateSessionButton" Content="Створити сесію" Classes="primary" Click="OnCreateSessionClicked" IsEnabled="{Binding CanCreateSession}" HorizontalAlignment="Stretch" />
                                <Button x:Name="SearchSessionsButton" Content="Знайти сесії" Classes="secondary" Click="OnSearchSessionsClicked" IsEnabled="{Binding CanSearchSessions}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding DiscoveryStatus}" Classes="label" TextWrapping="Wrap" />
                                <ComboBox x:Name="SessionList" ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch" PlaceholderText="Сесії в локальній мережі" AutomationProperties.Name="Знайдені сесії">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="discovery:DiscoveredPeer"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="JoinSessionButton" Content="Приєднатися" Classes="primary" Click="OnJoinSessionClicked" IsEnabled="{Binding CanJoinSession}" HorizontalAlignment="Stretch" />
                                <Expander x:Name="ManualConnectionExpander" Header="Підключитися вручну" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="6" Margin="0,8,0,0">
                                        <TextBlock Text="SessionId із запрошення" Classes="label" />
                                        <TextBox x:Name="SessionIdBox" Text="{Binding SessionId, Mode=TwoWay}" IsReadOnly="{Binding !CanEditSession}" FontSize="12" AutomationProperties.Name="SessionId із запрошення" />
                                        <TextBlock Text="IP-адреса пристрою" Classes="label" />
                                        <TextBox x:Name="RemoteAddressBox" Text="{Binding RemoteAddress, Mode=TwoWay}" AutomationProperties.Name="IP-адреса пристрою" />
                                        <TextBlock Text="TCP-порт пристрою" Classes="label" />
                                        <TextBox x:Name="RemotePortBox" Text="{Binding RemotePort, Mode=TwoWay}" AutomationProperties.Name="TCP-порт пристрою" />
                                        <Button Content="Приєднатися за IP" Classes="primary" Click="OnJoinManualClicked" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Локальний TCP-порт (0 — автоматично)" Classes="label" TextWrapping="Wrap" />
                                        <TextBox x:Name="LocalPortBox" Text="{Binding LocalPort, Mode=TwoWay}" IsReadOnly="{Binding !CanStartListening}" AutomationProperties.Name="Локальний TCP-порт" />
                                        <Button x:Name="ListenButton" Content="Слухати" Click="OnListenClicked" IsEnabled="{Binding CanStartListening}" HorizontalAlignment="Stretch" />
                                        <Button x:Name="ConnectButton" Content="Підключити" Classes="primary" Click="OnConnectClicked" IsEnabled="{Binding CanConnect}" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="Вузли поточної сесії" Classes="label" />
                                        <ComboBox x:Name="DiscoveredPeerList" ItemsSource="{Binding DiscoveredPeers}" SelectedItem="{Binding SelectedPeer, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="Вузли поточної сесії">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="discovery:DiscoveredPeer"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button x:Name="ConnectDiscoveredButton" Content="Підключити вибраний" Click="OnConnectDiscoveredClicked" IsEnabled="{Binding CanConnectDiscovered}" HorizontalAlignment="Stretch" />
                                        <TextBlock Text="{Binding OperationCount, StringFormat='Операцій у журналі: {0}'}" Classes="label" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander>
                                <Button x:Name="DisconnectButton" Content="Відключитися" Classes="secondary" Click="OnDisconnectClicked" IsEnabled="{Binding CanDisconnect}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border x:Name="FilesPanel" Grid.Row="1" IsVisible="{Binding #RootView.Layout.ShowFiles}">
                        <ScrollViewer x:Name="FileScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <Button x:Name="SaveProjectButton" Content="Зберегти проєкт" Classes="primary" Click="OnSaveProjectClicked" HorizontalAlignment="Stretch" />
                                <Button x:Name="OpenProjectButton" Content="Відкрити проєкт…" Classes="secondary" Click="OnOpenProjectClicked" HorizontalAlignment="Stretch" />
                                <CheckBox x:Name="VisibleContentOnly" IsChecked="True">
                                    <TextBlock Text="Експортувати лише видимі шари" TextWrapping="Wrap" />
                                </CheckBox>
                                <Button x:Name="ExportSvgButton" Content="Експорт SVG" Classes="secondary" Click="OnExportSvgClicked" HorizontalAlignment="Stretch" />
                                <Button x:Name="ExportPngButton" Content="Експорт PNG" Classes="secondary" Click="OnExportPngClicked" HorizontalAlignment="Stretch" />
                                <Separator Margin="0,8" />
                                <Button x:Name="ClearButton" Content="Очистити полотно" Classes="danger" Click="OnClearClicked" HorizontalAlignment="Stretch" ToolTip.Tip="Видалити відомі об'єкти на всіх шарах для всіх учасників" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <ScrollViewer x:Name="PropertiesPanel" Grid.Row="1" IsVisible="{Binding #RootView.Layout.ShowProperties}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="PropertiesHost" Spacing="12" />
                    </ScrollViewer>
                    <ScrollViewer x:Name="EditingPanel" Grid.Row="1" IsVisible="{Binding #RootView.Layout.ShowEditing}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EditingHost" Spacing="8" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="FooterGrid" Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding #RootView.Layout.ShowToolbarAndFooter}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" Text="{Binding Status}" Classes="label" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}" />
                <TextBlock x:Name="SelectionInfo" Classes="label" IsVisible="{Binding #RootView.Layout.ShowSelection}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock x:Name="ObjectCountText" Grid.Column="1" Text="{Binding ObjectCount, StringFormat='{}{0} об.'}" Classes="label" VerticalAlignment="Center" ToolTip.Tip="Кількість об'єктів" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="ZoomOutButton" Classes="icon secondary" Click="OnZoomOutClicked" ToolTip.Tip="Зменшити масштаб" AutomationProperties.Name="Зменшити масштаб">
                    <Path Classes="icon" Data="M4,12 L20,12" />
                </Button>
                <Button x:Name="ResetZoomButton" Content="100%" Classes="secondary" MinWidth="60" Click="OnResetViewClicked" ToolTip.Tip="Повернути масштаб 100% і центр полотна" AutomationProperties.Name="Скинути масштаб" />
                <Button x:Name="ZoomInButton" Classes="icon secondary" Click="OnZoomInClicked" ToolTip.Tip="Збільшити масштаб" AutomationProperties.Name="Збільшити масштаб">
                    <Path Classes="icon" Data="M4,12 L20,12 M12,4 L12,20" />
                </Button>
            </StackPanel>
        </Grid>
        <Border x:Name="ConfirmationOverlay" Grid.RowSpan="4" Background="#660F172A" IsVisible="False">
            <Border x:Name="ConfirmationDialog" Background="White" CornerRadius="10" Padding="16" Margin="8" MaxWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ScrollViewer x:Name="ConfirmationScroll" MaxHeight="{Binding #RootView.Layout.ConfirmationMaxHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Name="ConfirmationText" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="CancelActionButton" Content="Скасувати" Classes="secondary" Click="OnCancelActionClicked" Margin="0,0,8,8" />
                            <Button x:Name="ConfirmActionButton" Content="Підтвердити" Classes="primary" Click="OnConfirmActionClicked" Margin="0,0,0,8" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</UserControl>
